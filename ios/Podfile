require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

min_ios_version_supported = '15.5'  
platform :ios, min_ios_version_supported
prepare_react_native_project!
cpu_arch = `uname -m`.strip 

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Incyclist' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Google Maps SDK for iOS — Street View (GMSPanoramaView).
  #
  # iOS has no native Street View, so the ride screen's 'sv' view needs Google's
  # SDK here, the way Android needs play-services-maps.
  #
  # Pinned to 9.4.0, exactly, for two reasons:
  #
  #   1. It is the last release supporting iOS 15 (podspec: ios "15.0"). Every
  #      10.x requires iOS 16, which would raise min_ios_version_supported and
  #      make the app uninstallable on the iPhone 6s used for device testing.
  #   2. A pessimistic constraint (~> 9.4) would silently pick up a 9.x that
  #      moved the floor. This dependency is not one to let drift on its own.
  #
  # Note for whoever upgrades this: Google deprecated CocoaPods for the Maps SDK
  # as of 11.0.0 (Aug 2026) — 10.15.0 is the last CocoaPods release ever. Moving
  # past it means migrating this dependency to Swift Package Manager.
  #
  # Deliberately NOT wrapped in use_frameworks!: the podspec ships
  # GoogleMaps.xcframework as vendored_frameworks, which CocoaPods links and
  # embeds without it. Turning use_frameworks! on would rewrite linkage for every
  # pod in this project, MapLibre and the Nitro/MMKV stack included.
  pod 'GoogleMaps', '9.4.0'

  post_install do |installer|
    
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    

    installer.pods_project.build_configurations.each do |config|
      if cpu_arch == 'x86_64'
        config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "arm64"
      else
        config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "x86_64"
      end
    end
    
    # Add this inside your existing post_install do |installer| block
    installer.pods_project.targets.each do |target|

      # Force every target to match your Intel Mac architecture
      target.build_configurations.each do |config|
        if cpu_arch == 'x86_64'
          config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "arm64"
        else
          config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "x86_64"
        end
      end      

      $MLRN.post_install(installer)

      # Xcode 27 rejects deployment targets below iOS 15 (e.g. resource bundle targets that still
      # declare 9.0 / 12.4) - raise them to the app's minimum
      target.build_configurations.each do |config|
        deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if deployment_target && Gem::Version.new(deployment_target) < Gem::Version.new(min_ios_version_supported)
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end

    end
    
    
  end
end
